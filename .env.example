# ============================================================
# Manzil — environment variables
# Copy to .env.local and fill in. Without Supabase values the app
# runs in LOCAL mode with seeded sample data (great for preview/UI dev).
# ============================================================

# Where listing/search data comes from: "local" | "supabase"
DATA_PROVIDER=local

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (project → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: SERVER-ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin authentication ----------------------------------------------
# The admin panel (/admin/*) is protected by Supabase Auth. Login/roles only
# activate when running in "supabase" mode (set DATA_PROVIDER=supabase above
# AND provide the two public NEXT_PUBLIC_SUPABASE_* values). In local mode the
# panel stays open with a demo "Super Admin" session.
#
#   Roles (stored on auth.users.app_metadata.role):
#     super_admin — full access incl. managing agents
#     admin       — full access to content & leads, cannot manage agents
#     agent       — dashboard + own leads only
#
# Provision roles + Row Level Security once:
#     run supabase/sql/auth.sql in the Supabase SQL editor.
# Then stamp roles on users, e.g.
#     update auth.users set app_metadata = jsonb_set(coalesce(app_metadata,'{}'),
#       '{role}','"super_admin"') where email = 'you@manzil.pk';
# ============================================================================

# --- Storage: which provider to use for media: "supabase" | "cloudinary" | "s3" ---
MEDIA_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_BUCKET=manzil

# --- Search backend: "postgres" | "meilisearch" | "algolia" ---
SEARCH_PROVIDER=postgres

# Meilisearch (optional)
MEILISEARCH_HOST=
MEILISEARCH_KEY=
# Algolia (optional)
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_API_KEY=
ALGOLIA_ADMIN_KEY=

# Cloudinary (optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# AWS S3 (optional)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
